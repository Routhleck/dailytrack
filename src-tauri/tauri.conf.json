{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dailytrack",
  "version": "0.1.0",
  "identifier": "com.dailytrack.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "dailytrack",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Routhleck/dailytrack/releases/latest/download/latest.json"
      ],
      "pubkey": "untrusted comment: minisign public key: 4AB2A42AA2A170DF\nRWTfcKGiKqSySla+7ASD8uI2y4IZOwXj/AT7K5UnxZq+MRwqfibCkB1K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
